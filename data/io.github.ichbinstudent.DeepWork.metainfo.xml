<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ichbinstudent.DeepWork</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>DeepWork</name>
  <summary>Block distracting websites and apps</summary>
  <developer id="io.github.ichbinstudent">
    <name>DeepWork contributors</name>
  </developer>
  <description>
    <p>
      DeepWork blocks distracting websites and apps, on demand or on a schedule, and can lock a
      block so you can't give up halfway through. Blocks are enforced by a system service, so
      closing the app doesn't end them.
    </p>
    <ul>
      <li>Blocks with their own websites, apps, schedule and lock</li>
      <li>Website blocking in every browser, with browser policies for the Chromium family and Firefox</li>
      <li>Locks: random text, password, strict, until restart, and hardcore mode</li>
      <li>Breaks, pomodoro and daily allowances</li>
      <li>Statistics, a top-bar indicator and notifications</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.ichbinstudent.DeepWork.desktop</launchable>
  <url type="homepage">https://github.com/ichbinstudent/deepwork</url>
  <url type="bugtracker">https://github.com/ichbinstudent/deepwork/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>A running, locked block</caption>
      <image>https://raw.githubusercontent.com/ichbinstudent/deepwork/main/docs/screenshots/focus.png</image>
    </screenshot>
    <screenshot>
      <caption>Editing a block</caption>
      <image>https://raw.githubusercontent.com/ichbinstudent/deepwork/main/docs/screenshots/edit.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <releases>
